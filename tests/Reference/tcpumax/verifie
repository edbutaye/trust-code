#!/bin/bash

start="$(cat ./start_time)"
end="$(cat ./end_time)"
time=$(expr ${end} - ${start})

test_name="$1"

echo "Test case ${test_name}"
echo "Time taken: ${time} ms"

erreur=0

# Verify that the computation stopped after the correct time
# tcpumax 1e-3 in jdd should give 3600 ms exection time
# leave a margin for final postprocessing. Number may need tweaking
if [ "${time}" -gt "4000" ]; then
    echo "Error: tcpumax keyword did not work correctly"
    erreur=1
fi

# Verify that the computation stopped for the correct reason
if [ "$(grep 'max cpu time reached' $1.err 2>/dev/null)" = "" ]; then
    echo "Error: 'max cpu time reached' not found in $1.err"
    echo "       test case failed because test did not end for expected reasons ('max cpu time reached')"
    erreur=2
fi

exit $erreur
